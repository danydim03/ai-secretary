{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalDocument",
  "type": "object",
  "required": ["document_id", "version", "source", "blocks", "tables", "entities", "relations", "extraction_warnings", "provenance"],
  "properties": {
    "document_id": {"type": "string", "pattern": "^doc_"},
    "version": {"type": "integer", "minimum": 1},
    "source": {
      "type": "object",
      "required": ["source_id", "original_filename", "sha256", "mime_type", "ingested_at", "storage_uri"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^src_"},
        "original_filename": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "mime_type": {"type": "string"},
        "ingested_at": {"type": "string", "format": "date-time"},
        "storage_uri": {"type": "string"}
      },
      "additionalProperties": false
    },
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "tables": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "entities": {"type": "array"},
    "relations": {"type": "array"},
    "extraction_warnings": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "page": {"type": "integer"}, "message": {"type": "string"}}}},
    "provenance": {"type": "object", "required": ["pipeline_version", "parent_artifact_ids"], "properties": {"pipeline_version": {"type": "string"}, "parent_artifact_ids": {"type": "array", "items": {"type": "string"}}}}
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": ["block_id", "type", "raw_text", "normalized_text", "source_locator", "extraction"],
      "properties": {
        "block_id": {"type": "string", "pattern": "^blk_"},
        "type": {"enum": ["paragraph", "heading", "table"]},
        "raw_text": {"type": "string"},
        "normalized_text": {"type": "string"},
        "source_locator": {
          "type": "object",
          "properties": {
            "page": {"type": "integer", "minimum": 1},
            "bbox": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4},
            "char_range": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 2, "maxItems": 2},
            "paragraph_index": {"type": "integer", "minimum": 1},
            "table_index": {"type": "integer", "minimum": 1},
            "body_index": {"type": "integer", "minimum": 1}
          }
        },
        "extraction": {"type": "object", "required": ["engine", "confidence"], "properties": {"engine": {"type": "string"}, "confidence": {"type": ["number", "null"]}}}
      }
    }
  }
}
