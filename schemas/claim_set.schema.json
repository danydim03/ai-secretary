{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimSet",
  "type": "object",
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["claim_id", "text", "kind", "status", "evidence"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["quoted", "derived", "inferred", "assumption"] },
        "status": { "enum": ["supported", "unsupported", "assumption"] },
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^ev_doc_[a-f0-9]+_blk_[A-Za-z0-9_]+$" } },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
